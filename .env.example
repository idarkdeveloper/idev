# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Only if the API says the key "is not scoped to a workspace": the workspace ID (wrkspc_...)
# from the Claude Console, Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Model used by the agent (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- Market: "in" (NSE data + Groww) or "us" (QuiverQuant + Alpaca) ---
MARKET=in

# --- Strategy ---
# Investors whose disclosed trades to follow: INVESTORS, comma separated, up to 10. If INVESTORS is
# unset, the single WATCH_INVESTOR below is used. Names are matched case-insensitively, any word order.
# Each name is a name substring, case-insensitive.
# India: the client name as it appears in NSE bulk/block deals, e.g. ASHISH KACHOLIA,
#        MUKUL MAHAVIR AGRAWAL, VIJAY KEDIA, DOLLY KHANNA, RARE ENTERPRISES
# US:    a politician (congress) or insider name, e.g. Nancy Pelosi
INVESTORS=ASHISH KACHOLIA
# One name only (older form; ignored when INVESTORS is set):
# WATCH_INVESTOR=ASHISH KACHOLIA
# India: deals (bulk + block, default) | bulk | block | insider     US: congress | insider
WATCH_SOURCE=deals
# India: also read BSE bulk and block deals beside NSE's (public page, no login). false = NSE only.
BSE_DEALS=true
# BSE_HOST=beta.bseindia.com   (the WebForms page; www.bseindia.com now serves a JavaScript shell)
# India: show FII/DII flows and NIFTY 500 breadth in the morning email (public NSE files, fetched after 19:00 IST).
FLOWS_BREADTH=true
# India: never buy stocks in a 2% or 5% NSE price band (screen, agent, email buy ideas, practice buys); 10% is a caution.
PRICE_BAND_FILTER=true
# true = let the agent place orders itself (paper unless GROWW_LIVE_ORDERS=true).
AUTO_TRADE=false
# Practice money for the paper account (also with Groww linked: your real holdings
# are never copied into it). Backtests use the same amount.
PAPER_STARTING_CASH=500000

# --- Brokerage: Groww (India) https://groww.in/trade-api ---
# Option A: paste the daily access token from Groww > Trading APIs (expires 06:00 IST).
GROWW_ACCESS_TOKEN=
# Option B: API key + secret ("approval" flow, needs daily approval in the Groww app)...
GROWW_API_KEY=
GROWW_API_SECRET=
# ...or API key + TOTP secret (no daily approval). Run `python -m trading_agent groww-token`.
GROWW_TOTP_SECRET=
# (Options B/C: the generated token is cached in STATE_DIR/groww_token.json, owner-only,
#  and reused until 06:00 IST, because Groww allows only 150 token generations a day.)
# Groww has no sandbox. Default false = read your real holdings/prices, but fill orders in the
# local paper simulator. true = place REAL orders on Groww (also needs AUTO_TRADE=true).
GROWW_LIVE_ORDERS=false
GROWW_EXCHANGE=NSE
# Live orders are DAY LIMIT orders: buys at LTP x (1 + this %), sells at LTP x (1 - this %),
# rounded to the stock's tick size. Unfilled orders stay open; `orders --refresh` re-checks.
MAX_SLIPPAGE_PCT=0.5
# true = keep one GTT stop-loss SELL at Groww per live holding at the trailing stop
# (raised as the stop rises, never lowered, cancelled when sold). Needs GROWW_LIVE_ORDERS=true.
GROWW_GTT_STOPS=false
# SEBI 2026: Groww accepts API orders only from the IP you registered with them. Put that IP
# here and every live order first checks this machine's public IP and refuses from any other
# (find yours with: python -m trading_agent groww-check --ip). See docs/hosting.md.
GROWW_ALLOWED_IP=
# Optional: send every Groww call through a proxy with a fixed IP (e.g. from GitHub Actions).
GROWW_PROXY_URL=

# --- US alternative: QuiverQuant data + Alpaca paper trading ---
QUIVER_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Force a broker instead of auto-detecting from the keys above: local | groww | alpaca
# BROKER=local

# --- Notifications (optional) ---
# Resend (https://resend.com): if both are set, recommendations are emailed.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Trading Agent <agent@yourdomain.com>
# Any webhook (Slack/Discord/n8n...). Receives {"text": "..."} as JSON.
NOTIFY_WEBHOOK_URL=

# --- News headlines (optional) ---
# Who labels headlines positive/neutral/negative: auto (local Ollama if running, else unlabelled) | ollama | claude | none.
# "claude" is the only choice that costs money.
NEWS_TAGGER=auto
# Local Ollama server (install from ollama.com, then: ollama pull qwen2.5:3b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Used only when NEWS_TAGGER=claude
NEWS_CLAUDE_MODEL=claude-haiku-4-5

# --- Daily emails (optional; sent by the watch service on NSE trading days, needs an email or webhook above) ---
# A morning "what to buy / what to watch" brief and an evening "close" portfolio report. Never places an order.
DIGEST_ENABLED=true
DIGEST_MORNING_ON=true
DIGEST_EVENING_ON=true
# IST, HH:MM. A late start still sends the morning one before 12:00 and the evening one before 20:00.
DIGEST_MORNING=09:00
DIGEST_EVENING=15:45
# Index screened for buy ideas, and how many to list
DIGEST_UNIVERSE=NIFTYMIDCAP150
DIGEST_TOP=10
# Who writes the short "In short" summary on top: claude (default; Claude Haiku) | auto (Ollama, then Claude) | ollama |
# rules (built from the numbers, no AI) | none (no summary). Whenever the AI is unavailable (no key, error, timeout) or its
# text fails the checks, the email uses the rules summary, so there is always a correct one.
DIGEST_WRITER=claude
# Claude is used only when ANTHROPIC_API_KEY is set; the token use and cost of each email are logged
DIGEST_CLAUDE_MODEL=claude-haiku-4-5
# The evening email also carries a market bulletin: Nifty 50 levels, ADX/RSI, global markets, commodities and a concept of
# the day (readings of past prices, never a forecast). DIGEST_CHARTS=false sends it without the chart pictures.
DIGEST_BULLETIN=true
DIGEST_CHARTS=true
