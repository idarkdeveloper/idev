# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the agent (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- Market data: QuiverQuant (https://api.quiverquant.com) ---
QUIVER_API_KEY=...

# --- Brokerage: Alpaca paper trading (https://alpaca.markets) ---
# Leave both blank to use the built-in local paper broker (state/paper_broker.json).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Strategy ---
# Investor whose disclosed trades to follow (name substring, case-insensitive).
WATCH_INVESTOR=Nancy Pelosi
# congress | insider
WATCH_SOURCE=congress
# Starting cash for the local paper broker.
PAPER_STARTING_CASH=80000
# true = let the agent place PAPER orders itself. false = recommendations only.
AUTO_TRADE=false

# --- Notifications (optional) ---
# Resend (https://resend.com): if both are set, recommendations are emailed.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Trading Agent <agent@yourdomain.com>
# Any webhook (Slack/Discord/n8n...). Receives {"text": "..."} as JSON.
NOTIFY_WEBHOOK_URL=
