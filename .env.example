# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Only if the API says the key "is not scoped to a workspace": the workspace ID (wrkspc_...)
# from the Claude Console, Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Model used by the agent (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- Market: "in" (NSE data + Groww) or "us" (QuiverQuant + Alpaca) ---
MARKET=in

# --- Strategy ---
# Investors whose disclosed trades to follow: INVESTORS, comma separated, up to 10. If INVESTORS is
# unset, the single WATCH_INVESTOR below is used. Names are matched case-insensitively, any word order.
# Each name is a name substring, case-insensitive.
# India: the client name as it appears in NSE bulk/block deals, e.g. ASHISH KACHOLIA,
#        MUKUL MAHAVIR AGRAWAL, VIJAY KEDIA, DOLLY KHANNA, RARE ENTERPRISES
# US:    a politician (congress) or insider name, e.g. Nancy Pelosi
INVESTORS=ASHISH KACHOLIA
# One name only (older form; ignored when INVESTORS is set):
# WATCH_INVESTOR=ASHISH KACHOLIA
# India: deals (bulk + block, default) | bulk | block | insider (instead of deals) | all (deals + insider filings)
#   US: congress | insider
WATCH_SOURCE=deals
# India: read every NSE insider (PIT) filing every 15 min: alerts for your stocks, the stock page, big insider buys
INSIDER_TRADES=true
# smallest insider open-market buy on the dashboard list, in rupees (1 crore)
INSIDER_MIN_BUY=10000000
# India: mutual funds, foreign funds and insurers in every stock's bulk/block deals: alerts for your stocks, dashboard
BIG_MONEY=true
# smallest institutional deal on the dashboard list, in rupees (10 crore)
BIG_MONEY_MIN=100000000
# India: also read BSE bulk and block deals beside NSE's (public page, no login). false = NSE only.
BSE_DEALS=true
# BSE_HOST=beta.bseindia.com   (the WebForms page; www.bseindia.com now serves a JavaScript shell)
# India: show FII/DII flows and NIFTY 500 breadth in the morning email (public NSE files, fetched after 19:00 IST).
FLOWS_BREADTH=true
# India: never buy stocks in a 2% or 5% NSE price band (screen, agent, email buy ideas, practice buys); 10% is a caution.
PRICE_BAND_FILTER=true
# India: buys only (sells never blocked). Never buy stocks on NSE's ASM/GSM surveillance lists; no new buy when the board
# meets for results within 5 trading days; no buy when promoter pledges exceed 20% of their holding or rose > 5 points.
# Lists come from NSE once per trading day; when one cannot be read that filter blocks nothing and says so.
ASM_GSM_FILTER=true
RESULTS_BLACKOUT_FILTER=true
PLEDGE_FILTER=true
# Screener page: extra TradingView columns. UNOFFICIAL endpoint whose terms restrict automated access: off unless you turn it on.
# One request per list at most every 15 minutes; any error or HTTP 403/429 pauses it for 24 hours. Display only.
TRADINGVIEW_SCREENER=false
# Set TA_ROLE=server in the cloud server's .env (the box whose IP is registered with Groww): it then never calls TradingView.
# TA_ROLE=server
# true = let the agent place orders itself (paper unless GROWW_LIVE_ORDERS=true).
AUTO_TRADE=false
# Practice money for the paper account (also with Groww linked: your real holdings
# are never copied into it). Backtests use the same amount.
PAPER_STARTING_CASH=500000

# --- Brokerage: Groww (India) https://groww.in/trade-api ---
# Option A: paste the daily access token from Groww > Trading APIs (expires 06:00 IST).
GROWW_ACCESS_TOKEN=
# Option B: API key + secret ("approval" flow, needs daily approval in the Groww app)...
GROWW_API_KEY=
GROWW_API_SECRET=
# ...or API key + TOTP secret (no daily approval). Run `python -m trading_agent groww-token`.
GROWW_TOTP_SECRET=
# (Options B/C: the generated token is cached in STATE_DIR/groww_token.json, owner-only,
#  and reused until 06:00 IST, because Groww allows only 150 token generations a day.)
# Groww has no sandbox. Default false = read your real holdings/prices, but fill orders in the
# local paper simulator. true = place REAL orders on Groww (also needs AUTO_TRADE=true).
GROWW_LIVE_ORDERS=false
GROWW_EXCHANGE=NSE
# Groww is called mainly in this window (IST, NSE trading days). The watch service saves one read of your holdings
# at the close (15:35-15:50); evenings, nights, weekends and holidays use that saved copy (priced from Yahoo).
GROWW_WINDOW_START=08:30
GROWW_WINDOW_END=16:00
# Phone app feed (read-only): while the Groww window is open the watch service rebuilds state/app/app_feed.json from one
# Groww read at most every APP_FEED_EVERY_S seconds (minimum 60). Off by default. Needs Groww linked.
APP_FEED=false
APP_FEED_EVERY_S=300
# Groww live prices for the dashboard's holdings (read-only Live Data LTP, one call a minute for up to 50 holdings while the
# NSE is open, inside the Groww window; needs APP_FEED=true so the holdings are known, and a Groww plan with Live Data).
# Off by default. If the call fails the dashboard silently keeps Yahoo's delayed prices. Minimum interval 30 s.
LIVE_PRICES=false
LIVE_PRICES_EVERY_S=60
# Live orders are DAY LIMIT orders: buys at LTP x (1 + this %), sells at LTP x (1 - this %),
# rounded to the stock's tick size. Unfilled orders stay open; `orders --refresh` re-checks.
MAX_SLIPPAGE_PCT=0.5
# Opening collar (live buys; practice buys keep only the time rule): no buy before OPEN_COLLAR_START (IST); until
# OPEN_COLLAR_END the buy limit is the lower of the MAX_SLIPPAGE_PCT cap and today's opening price + OPEN_COLLAR_BPS
# basis points (rounded down to the tick), after it the MAX_SLIPPAGE_PCT cap alone; a live buy still unfilled after
# BUY_TIMEOUT_S seconds is cancelled.
OPEN_COLLAR_START=09:17
OPEN_COLLAR_END=09:45
OPEN_COLLAR_BPS=30
BUY_TIMEOUT_S=120
# Day brake: when the live account is down this many percent from the previous close during the session, no new
# buys until the next session (sells and the GTT stops at Groww still act); one alert.
DAY_BRAKE_PCT=3.5
# true = keep one GTT stop-loss SELL at Groww per live holding at the trailing stop
# (raised as the stop rises, never lowered, cancelled when sold). Needs GROWW_LIVE_ORDERS=true.
GROWW_GTT_STOPS=false
# A delivery SELL needs DDPI on your demat account (Groww app: Profile > Settings > Demat/DDPI; or a daily
# CDSL TPIN/OTP, which a headless agent cannot give). Groww's API cannot tell us, so confirm it yourself and
# set true. While false, live sells still run (if live orders are on) but alert once a day: sells may be rejected.
GROWW_DDPI_CONFIRMED=false
# false (default) = live sells use only the free demat quantity. true = also T1 shares (bought yesterday, not
# yet in the demat): a BTST sale with short-delivery / auction risk.
GROWW_SELL_T1=false
# SEBI 2026: Groww accepts API orders only from the IP you registered with them. Put that IP
# here and every live order first checks this machine's public IP and refuses from any other
# (find yours with: python -m trading_agent groww-check --ip). See docs/hosting.md.
GROWW_ALLOWED_IP=
# Optional: send every Groww call through a proxy with a fixed IP (e.g. from GitHub Actions).
GROWW_PROXY_URL=

# --- US alternative: QuiverQuant data + Alpaca paper trading ---
QUIVER_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Force a broker instead of auto-detecting from the keys above: local | groww | alpaca
# BROKER=local

# --- Notifications (optional) ---
# Resend (https://resend.com): if both are set, recommendations are emailed.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Trading Agent <agent@yourdomain.com>
# Any webhook (Slack/Discord/n8n...). Receives {"text": "..."} as JSON.
NOTIFY_WEBHOOK_URL=
# Telegram: with both set, every alert and daily email also goes to this chat. Token from @BotFather
# (looks like 123456789:AA...), chat id from getUpdates (a number, or @yourchannel). TELEGRAM_ALERTS=false switches it off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS=true
# Telegram commands (step 1, practice only): true = the watch service answers /help /status /lookup /size /portfolio
# /brief /stops and PRACTICE /buy /sell (each with a Confirm button, 2 min) from TELEGRAM_CHAT_ID only. Never places a
# live order, whatever GROWW_LIVE_ORDERS says. Off by default.
TELEGRAM_COMMANDS=false

# --- Phone access (optional) ---
# The dashboard answers only to localhost by default (a Host-header check stops DNS-rebinding attacks). To open it
# from a phone through `tailscale serve`, list your tailnet name here (comma list, exact names, no wildcards).
TA_ALLOWED_HOSTS=

# --- Server health (optional) ---
# Dead-man's switch: the watch service pings this https URL every minute (a healthchecks.io, Better Stack or
# UptimeRobot heartbeat URL). Its path is a secret. If the pings stop, that site emails you.
HEARTBEAT_URL=
# The paper forward test the server runs once a trading day after the close (16:10 IST)
FORWARD_UNIVERSE=NIFTYMIDCAP150
# The day the forward test started. If the server finds no forward account it rebuilds it from this date (point in
# time, closes of that day) instead of silently starting a new one; without it, it alerts once a day and does nothing.
FORWARD_START=2026-10-09
# The prediction model's own paper account (practice money only): fitted once on the development years, frozen,
# then each month it sizes the momentum top 20 by its probabilities. From this date, after the close; off = never.
MODEL_PAPER_START=2026-10-19
# Residual momentum (variant E; failed the 2017-2020 check rerun on daily prices, kept as fixed in advance) in its own paper account: the forward
# test's names, filters and rules, ranked by residual momentum instead. 12 months beside the adopted rules decide.
# From this date, after the close; off = never.
RESMOM_PAPER_START=2026-10-19
# Variant B (top 10; passed the 2017-2020 check rerun on daily prices) in its own paper account: the forward test's
# screen and filters, 10 names kept while ranked 18 or better. 12 months beside the adopted rules decide. Off = never.
TOP10_PAPER_START=2026-10-19
# The drawdown brake (100-day average; passed the India Oct 2007 - Mar 2016 test, lost in 2020-2025) in its own paper
# account: the adopted rules, all in cash while MID150BEES is below its 100-day average. Practice money only. Off = never.
BRAKE_PAPER_START=2026-10-20
# Heartbeat: "fail" pings go only to hc-ping.com unless this is true (other providers just see the pings stop)
HEARTBEAT_FAIL=false

# --- News headlines (optional) ---
# Who labels headlines positive/neutral/negative: auto (local Ollama if running, else unlabelled) | ollama | claude | none.
# "claude" is the only choice that costs money.
NEWS_TAGGER=auto
# Where each news alert goes: telegram (a push, no email) | email | both. Empty (default) = telegram when Telegram is set up,
# else email. Telegram failing for one alert sends that one alert by email. By email, at most one alert per stock per 30 minutes;
# the rest are in the morning and evening digests ("News today").
NEWS_ALERT_CHANNELS=
# Ask: the Ctrl+K palette understands sentences ("tell me Tata Motors detail", "read today's news") by rules first, then, when no
# rule fits, a local Ollama model (OLLAMA_MODEL). It only opens pages and reads the news; it never places or prepares an order.
ASK_ENABLED=true
ASK_OLLAMA=true
ASK_RATE_PER_MIN=30
# The voice assistant bar ("Ask about your market...", a mic and a voice card) at the bottom of every page; it is part of Ask, so
# ASK_ENABLED=false hides it too. false = no bar. Read-only: it opens pages and reads the news, it never places or prepares an order.
VOICE_UI=true
# The research tools (factor screen, portfolio backtest, signal lab, screener) keep price histories in memory for 10 minutes and
# load the default universes a little after the dashboard starts. RESEARCH_WARM=false turns the start-up load off;
# RESEARCH_CACHE_MAX is the most series kept in memory (default 600). A series is about 150 KB for 2 years and about 900 KB for
# 10 years, so the worst case is 600 x 900 KB = 540 MB; lower it on a small server. The warm-up never runs while the NSE is open
# (it fetches from Yahoo); it mainly prepares the price archive and disk cache, and holds series in memory for 30 minutes.
RESEARCH_WARM=true
RESEARCH_CACHE_MAX=600
# Local Ollama server (install from ollama.com, then: ollama pull qwen2.5:3b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Used only when NEWS_TAGGER=claude
NEWS_CLAUDE_MODEL=claude-haiku-4-5
# News alerts read the publisher's article (Google News links decoded) and put a summary written by the
# tagger's model in the email: key takeaways, the story, a clean "Read the original" button. false = headline only.
NEWS_FULL_STORY=true

# --- Daily emails (optional; sent by the watch service on NSE trading days, needs an email or webhook above) ---
# A morning "what to buy / what to watch" brief and an evening "close" portfolio report. Never places an order.
DIGEST_ENABLED=true
DIGEST_MORNING_ON=true
DIGEST_EVENING_ON=true
# IST, HH:MM. A late start still sends the morning one before 12:00 and the evening one before 20:00.
DIGEST_MORNING=09:00
DIGEST_EVENING=15:45
# Index screened for buy ideas, and how many to list
DIGEST_UNIVERSE=NIFTYMIDCAP150
DIGEST_TOP=10
# Who writes the short "In short" summary on top: claude (default; Claude Haiku) | auto (Ollama, then Claude) | ollama |
# rules (built from the numbers, no AI) | none (no summary). Whenever the AI is unavailable (no key, error, timeout) or its
# text fails the checks, the email uses the rules summary, so there is always a correct one.
DIGEST_WRITER=claude
# Claude is used only when ANTHROPIC_API_KEY is set; the token use and cost of each email are logged
DIGEST_CLAUDE_MODEL=claude-haiku-5-5
# The evening email also carries a market bulletin: Nifty 50 levels, ADX/RSI, global markets, commodities and a concept of
# the day (readings of past prices, never a forecast). DIGEST_CHARTS=false sends it without the chart pictures.
DIGEST_BULLETIN=true
DIGEST_CHARTS=true

# Read-only check of the live services (NSE, BSE, Yahoo, archives, Groww with a cached token) at 08:30 IST on trading days;
# a failure sends one alert a day. INTEGRATION_CLAUDE adds one 5-token Claude Haiku call.
INTEGRATION_CHECK=true
INTEGRATION_CLAUDE=false
